rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }
    // NOTE: isGroupMember()는 현재 아래 groups/messages 규칙에서 사용하지 않습니다.
    // (그룹 문서가 없을 때 get()이 실패해 permission-denied가 나는 문제가 있어
    //  테스트/개발 단계에서는 isSignedIn()만으로 완화했습니다. 운영 배포 전에는
    //  groups/{groupId}와 messages 규칙을 isGroupMember 기반으로 되돌리는 것을 권장합니다.)

    // 채팅방이 폭파(closed)되었는지 확인합니다. 폭파된 방에는 새 메시지를 쓸 수 없습니다.
    function groupIsClosed(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.get('closed', false) == true;
    }

    // ---- users/{uid} ----
    // 본인 프로필만 읽고/쓸 수 있습니다. uid, createdAt은 위조 방지를 위해 값 검증합니다.
    match /users/{uid} {
      // 채팅방 관리 화면에서 참여자 닉네임/프로필 사진/연속 기록(journalEntryCount)을
      // 보여주려면 다른 로그인 유저의 프로필도 읽을 수 있어야 하므로 isSignedIn()으로
      // 열어 두었습니다. 실제 "같은 채팅방 멤버만" 조건은 위 groups/{groupId} 규칙이
      // 멤버가 아니면 애초에 그 방의 members(uid 목록) 자체를 못 읽게 막는 것으로
      // 강제됩니다 - uid는 추측 불가능한 랜덤 값이라 그룹을 통하지 않고는 다른 사람의
      // uid를 알아낼 방법이 없습니다. 개인 묵상 기록(journals 서브컬렉션)은 아래처럼
      // 여전히 본인만 읽을 수 있고, 다른 유저에게는 journalEntryCount 숫자만
      // 노출됩니다.
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // users/{uid}/journals/{book_chapter} : 본인의 묵상 기록만 접근 가능
      match /journals/{entryId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- groups/{groupId} ----
    // 테스트/개발 단계: 로그인한 유저라면 그룹 생성이 가능하도록 완화했습니다.
    // (운영 배포 전에는 create도 좀 더 좁히는 것을 검토하세요. read는 아래처럼 이미
    // 실제 멤버(+방장)로 제한되어 있습니다.)
    match /groups/{groupId} {
      // 채팅방 관리 화면에서 참여자 프로필(닉네임/사진/연속 기록)을 볼 수 있는 사람은
      // 실제로 그 채팅방에 속한 멤버로 한정되어야 하므로, 로그인 여부만 보던 것에서
      // "방장이거나 members 배열에 포함된 경우"로 좁혔습니다.
      // resource == null 허용은 ensureGroup()이 새 방을 만들기 전에 먼저 존재 여부를
      // 확인하는 get()을 위한 것으로(문서가 없으면 어차피 노출될 데이터가 없음), 실제
      // 데이터 보호와는 무관합니다.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.members
      );

      // 로그인한 유저는 그룹을 생성할 수 있음
      allow create: if isSignedIn();

      // 그룹 문서 수정: 이름(name)/프로필 사진(photoUrl)/폭파 여부(closed, closedAt)는
      // 방장(ownerUid)만 바꿀 수 있습니다. 일반 멤버는 멤버 목록(members) 필드만
      // (참여/나가기를 위해) 바꿀 수 있습니다. 이미 폭파된 방은 더 이상 수정할 수 없습니다.
      allow update: if isSignedIn() &&
        resource.data.get('closed', false) == false &&
        (
          resource.data.ownerUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        );

      // 그룹 삭제는 소유자만
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // groups/{groupId}/messages/{messageId} : 로그인한 유저는 읽고 쓸 수 있음.
      // 메시지는 본인 uid로만 작성 가능하고, 작성 후 수정/삭제는 막습니다(대화 기록 보존).
      // 방장이 채팅방을 폭파(closed=true)한 뒤에는 새 메시지를 쓸 수 없습니다.
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
          !groupIsClosed(groupId);
        allow update, delete: if false;
      }
    }

    // ---- bibles/{book_chapter} ----
    // 성경 본문은 모든 로그인 사용자가 읽을 수 있는 공용 데이터입니다.
    // 오탈자 방지를 위해 클라이언트에서의 쓰기는 막고, Firebase 콘솔/Admin SDK로만 등록합니다.
    match /bibles/{chapterId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
