rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // ---- users/{uid} ----
    // 본인 프로필만 읽고/쓸 수 있습니다. uid, createdAt은 위조 방지를 위해 값 검증합니다.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // users/{uid}/journals/{book_chapter} : 본인의 묵상 기록만 접근 가능
      match /journals/{entryId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- groups/{groupId} ----
    match /groups/{groupId} {
      // 그룹 멤버만 조회 가능
      allow read: if isGroupMember(groupId);

      // 생성자는 자기 자신을 owner이자 유일한 멤버로 하여 그룹을 만들 수 있음
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.members == [request.auth.uid];

      // 기존 멤버의 수정 또는, 본인 uid 한 명만 members에 추가하는 "참여" 요청만 허용
      allow update: if isGroupMember(groupId) ||
        (isSignedIn() &&
          request.resource.data.members == resource.data.members.concat([request.auth.uid]));

      // 그룹 삭제는 소유자만
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // groups/{groupId}/messages/{messageId} : 그룹 멤버만 읽고 쓸 수 있음.
      // 메시지는 본인 uid로만 작성 가능하고, 작성 후 수정/삭제는 막습니다(대화 기록 보존).
      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- bibles/{book_chapter} ----
    // 성경 본문은 모든 로그인 사용자가 읽을 수 있는 공용 데이터입니다.
    // 오탈자 방지를 위해 클라이언트에서의 쓰기는 막고, Firebase 콘솔/Admin SDK로만 등록합니다.
    match /bibles/{chapterId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
