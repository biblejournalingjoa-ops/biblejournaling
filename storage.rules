rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // profile-images/{uid}/{fileName} : 본인 프로필 사진만 읽고 쓸 수 있습니다.
    // 다른 사용자의 uid 경로에는 업로드/열람이 모두 차단됩니다.
    match /profile-images/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // chatRooms/{chatRoomId}/profileImage : 채팅방 프로필 사진입니다. 같은 방에
    // 있는 모두가 볼 수 있어야 하므로 읽기는 로그인한 사용자 누구나 가능하지만,
    // 업로드/교체/삭제는 Firestore groups/{chatRoomId}.ownerUid와 일치하는
    // 방장만 할 수 있도록 Firestore 문서를 직접 조회해 확인합니다.
    match /chatRooms/{chatRoomId}/profileImage {
      function isChatRoomOwner() {
        return request.auth != null &&
          firestore.get(/databases/(default)/documents/groups/$(chatRoomId)).data.ownerUid == request.auth.uid;
      }
      allow read: if request.auth != null;
      allow write: if isChatRoomOwner() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isChatRoomOwner();
    }
  }
}
